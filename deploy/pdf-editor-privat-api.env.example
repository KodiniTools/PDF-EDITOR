# Konfiguration des Backends (pdf-editor-privat-api).
# Einmalig anlegen:
#   sudo install -d -m 755 /etc/kodini
#   sudo install -m 600 -o root -g root deploy/pdf-editor-privat-api.env.example /etc/kodini/pdf-editor-privat-api.env
#   sudo nano /etc/kodini/pdf-editor-privat-api.env   # API-Key eintragen
#
# Die Datei liest systemd als root; der Dienst selbst laeuft ohne Leserecht darauf.

# Pflicht: API-Key von https://platform.claude.com (bleibt nur auf dem Server)
ANTHROPIC_API_KEY=

# Port auf 127.0.0.1. Vorher pruefen, ob er frei ist:  ss -tlnp | grep -w 3417
# Bei Aenderung auch proxy_pass in der nginx-Konfiguration anpassen!
PORT=3417

# Optional
#ANTHROPIC_MODEL=claude-opus-5-5     # Standard, wenn im Browser nichts gewählt ist
#ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-fable-5-2   # im Browser wählbar
#ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
#MAX_CHARS=60000                # Text pro Schwärzungsanfrage
#MAX_ASK_CHARS=400000           # Dokumenttext pro Frage (Fragen zum Dokument)
#MAX_BODY_BYTES=1000000         # passt zu client_max_body_size 1m in nginx
#TIMEOUT_MS=180000              # Zeitlimit pro KI-Aufruf

# Kostenrechner (Button „Kosten“): zählt ohne weitere Einstellung die Tokens jeder
# Anfrage dieser App und rechnet sie nach Listenpreis um. Gespeichert in
# /var/lib/pdf-editor-privat-api/usage.json (systemd StateDirectory).
#USAGE_FILE=/var/lib/pdf-editor-privat-api/usage.json   # nur bei Bedarf ändern
#
# Optional: echte Kosten der ganzen Organisation statt der eigenen Zählung. Geht nur
# mit einem Admin-Key (Console → Settings → Admin keys, beginnt mit sk-ant-admin);
# normale API-Keys liefern 403. Lehnt Anthropic den Key ab, gilt automatisch die
# eigene Zählung. Ein Admin-Key darf die Organisation verwalten; er bleibt nur hier.
#ANTHROPIC_ADMIN_KEY=
