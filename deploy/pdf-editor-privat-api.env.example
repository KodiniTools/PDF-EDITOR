# Konfiguration des Backends (pdf-editor-privat-api).
# Einmalig anlegen:
#   sudo install -d -m 755 /etc/kodini
#   sudo install -m 600 -o root -g root deploy/pdf-editor-privat-api.env.example /etc/kodini/pdf-editor-privat-api.env
#   sudo nano /etc/kodini/pdf-editor-privat-api.env   # API-Key eintragen
#
# Die Datei liest systemd als root; der Dienst selbst laeuft ohne Leserecht darauf.

# Pflicht: API-Key von https://platform.claude.com (bleibt nur auf dem Server)
ANTHROPIC_API_KEY=

# Port auf 127.0.0.1. Vorher pruefen, ob er frei ist:  ss -tlnp | grep -w 3417
# Bei Aenderung auch proxy_pass in der nginx-Konfiguration anpassen!
PORT=3417

# Optional
#ANTHROPIC_MODEL=claude-opus-5-5
#ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
#MAX_CHARS=60000                # Text pro Schwärzungsanfrage
#MAX_ASK_CHARS=400000           # Dokumenttext pro Frage (Fragen zum Dokument)
#MAX_BODY_BYTES=1000000         # passt zu client_max_body_size 1m in nginx
#TIMEOUT_MS=180000              # Zeitlimit pro KI-Aufruf
